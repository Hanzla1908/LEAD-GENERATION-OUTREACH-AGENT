# Copy to .env in the backend folder for local development. Never commit .env.
# Production values are set in the Render dashboard, not in this file. See docs/DEPLOYMENT.md.

# Anthropic (AI drafts). Create a key at https://console.anthropic.com/ and keep it secret.
# Leave empty here and paste your key into your own .env file.
ANTHROPIC_API_KEY=


# Google Places API (New) — https://console.cloud.google.com/
# DEMO_MODE=true returns sample records and never calls Google (default).
# DEMO_MODE=false uses live Google Places (New) searches and needs GOOGLE_PLACES_API_KEY.
DEMO_MODE=true
GOOGLE_PLACES_API_KEY=
PLACES_MAX_RESULTS=60
PLACES_TIMEOUT_SECONDS=15

# Database
# Local: a SQLite file (default). Production: a PostgreSQL URL, for example
# postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME (postgres:// and postgresql:// also work).
DATABASE_URL=restaurant_outreach.db

# Runtime
# APP_ENV=production turns on production checks, hides API docs, enables HSTS and JSON logs.
APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO
LOG_JSON=false
RATE_LIMIT_ENABLED=false
# Trust X-Forwarded-For for the client address. Only true behind a proxy that sets it (Render does).
TRUST_PROXY_HEADERS=false
# Largest accepted request body in bytes (1 KB to 1 MB).
MAX_REQUEST_BYTES=65536

# Accounts: there is no shared password. Create the first admin with `python scripts/create_admin.py`
# (run from the backend folder). Everyone else gets an account from the Users page.
# SESSION_SECRET signs sign-in tokens. Production needs 32+ characters. Never reuse it elsewhere.
SESSION_SECRET=
# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email sending (Phase 8). Keep the default mock mode unless you intend to send real email.
# mock = recorded in the app only. nodemailer = send through the email-service (email-service\.env).
EMAIL_PROVIDER=mock
MOCK_EMAIL_MODE=true
EMAIL_SERVICE_URL=http://127.0.0.1:3001
EMAIL_SERVICE_SECRET=replace-with-the-same-long-random-string-as-email-service
EMAIL_PER_MINUTE=5
EMAIL_DAILY_LIMIT=100
# Signs unsubscribe links. 16+ characters, 32+ recommended. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
UNSUBSCRIBE_SECRET=
# The public address of the deployed app, where recipients open unsubscribe links, for example
# https://outreach.example.com (no trailing slash). Required before sending. Never localhost for live sending:
# the app refuses to send live email while this points at localhost or 127.0.0.1.
PUBLIC_BASE_URL=
# Required before any LIVE sending: your business name and postal address, printed in every email.
# Mock sending does not need it.
SENDER_ADDRESS=

# Delivery events from a provider webhook (Phase 18). Leave empty until a provider with webhooks is set up.
# At least 32 random characters. The provider signs each request with it.
EMAIL_WEBHOOK_SECRET=
# Mailbox monitor (bounces and replies over IMAP). Use the sending mailbox. Leave empty to disable.
MAILBOX_IMAP_HOST=
MAILBOX_IMAP_PORT=993
MAILBOX_USERNAME=
MAILBOX_PASSWORD=
MAILBOX_FOLDER=INBOX
