# Copy to frontend/.env (never commit .env) and set before `npm run build`.
#
# Public URL of the FastAPI backend, with no trailing slash and no /api suffix.
# Leave empty for local development: Vite proxies /api to http://localhost:8000.
# Production example (Render): VITE_API_ORIGIN=https://ro-backend.onrender.com
VITE_API_ORIGIN=
