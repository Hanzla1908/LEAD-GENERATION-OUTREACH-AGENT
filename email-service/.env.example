# Copy to email-service\.env. Never commit the real file.

# mock = nothing leaves this machine (default). smtp = real delivery through SMTP_*.
MAIL_MODE=mock

# Shared secret with the FastAPI backend (EMAIL_SERVICE_SECRET in the root .env). At least 16 characters.
EMAIL_SERVICE_SECRET=replace-with-a-long-random-string

# Bind to localhost only. The backend is the only intended caller.
EMAIL_SERVICE_HOST=127.0.0.1
EMAIL_SERVICE_PORT=3001

# Required when MAIL_MODE=smtp.
MAIL_FROM=Outreach Team <outreach@your-domain.example>
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Where the idempotency ledger is stored. Keep it: it prevents duplicate sends after restarts.
SEND_LEDGER_PATH=data/send-ledger.json
